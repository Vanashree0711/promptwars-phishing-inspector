# ============================================================
# Fake Offer Letter & Phishing Inspector — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Safe Browsing API (optional but recommended) ---
# Obtain a key at: https://developers.google.com/safe-browsing/v4/get-started
# Enable "Safe Browsing API" in your Google Cloud project.
# Without this key, Safe Browsing URL checks are skipped (graceful degradation).
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# --- Google Cloud Vision API (required for image OCR) ---
# Used to extract text from uploaded offer letter images (JPG, PNG, WebP).
# Obtain a key at: https://console.cloud.google.com/
# Enable "Cloud Vision API" in your Google Cloud project.
# Without this key, image uploads will show a configuration prompt;
# PDF uploads will still work without it.
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# --- Server configuration ---
PORT=3000
NODE_ENV=development
