# ============================================================
# Fake Offer Letter & Phishing Inspector — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Safe Browsing API (REQUIRED for Safe Browsing checks) ---
# Obtain a key at: https://developers.google.com/safe-browsing/v4/get-started
# Enable "Safe Browsing API" in your Google Cloud project.
# The application works without this key but Safe Browsing checks
# will be skipped (graceful degradation).
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# --- Server configuration ---
PORT=3000
NODE_ENV=development
